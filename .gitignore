# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/

# 误操作导致 tsc in-source emit 的编译产物（正确产物应输出到各包 dist/）
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map

# Test coverage
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
.cache/
temp/
# 本地构建临时目录（esbuild / vitest 结果文件；系统 TEMP 权限受限时使用）
.tmp-build/
.tmp-esbuild/
.playwright-cli/
dist-broken-*/

# Python（ComfyUI 插件本地跑过就会生成）
__pycache__/
*.pyc

tools/*.png
